# Reflect — shared server configuration (placeholders only; never commit real secrets)

# R3 — Python similarity service (server-only; never exposed to the browser)
SIMILARITY_SERVICE_URL=http://127.0.0.1:8000

# R4 — critic provider: "ollama" (local Qwen3-VL) or "gemini" (hosted fallback)
CRITIC_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=

# R4 — ElevenLabs voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# R2 — Capture/vision (MediaPipe). Defaults load from CDN; override to self-host.
# WASM fileset directory and the Pose Landmarker .task model.
NEXT_PUBLIC_MEDIAPIPE_WASM_BASE=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm
NEXT_PUBLIC_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/latest/pose_landmarker_lite.task

# Server-only. Never commit real values.
SIMILARITY_SERVICE_URL=http://127.0.0.1:8000
# Shared secret; set the SAME value for the Python service and the Next app whenever the
# service is reachable from the internet (tunnel for a Vercel deploy, see docs/deploy-vercel.md).
# Leave empty for a local-only laptop demo.
SIMILARITY_SERVICE_TOKEN=
CRITIC_PROVIDER=gemini        # gemini | ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-flash-latest  OLLAMA_MODEL=qwen3-vl:4b  CRITIC_TIMEOUT_MS=8000
# Optional: GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash  (tried on 429/5xx/404; "none" disables)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: ELEVENLABS_MODEL_ID=eleven_multilingual_v2  SPEECH_TIMEOUT_MS=6000
